# Ollama model and generation settings
OLLAMA_MODEL=beam:cloud
OLLAMA_MAX_TOKEN_OUTPUT=4096
OLLAMA_TEMPERATURE=0.2

# Optional. Leave blank to use the Ollama client's default host.
OLLAMA_HOST=

# Optional episodic-memory embedding and vector database (for --live demo)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_OUTPUT_DIMENSION=1024
COHERE_EMBED_URL=https://api.cohere.com/v2/embed
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=episodic_memory
QDRANT_VECTOR_NAME=

# Optional. Leave blank to disable the remote Zapier MCP server.
ZAPIER_URL=
ZAPIER_TOKEN=
